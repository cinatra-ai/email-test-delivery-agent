    "plan_test_send": {
      "component_type": "ApiNode",
      "id": "plan_test_send",
      "name": "Plan the test send",
      "url": "{{CINATRA_BASE_URL}}/api/agents/passthrough",
      "http_method": "POST",
      "data": {
        "tool": "campaign_test_send_plan",
        "input": {
          "envelopeJson": "{{ envelopeJson }}"
        },
        "agent_run_id": "{{ cinatra_run_id }}",
        "result_shape": "test_delivery_send"
      },
      "metadata": {
        "cinatra": {
          "riskClass": "write",
          "requiresApproval": false,
          "publishes": false,
          "packageName": "@cinatra-ai/email-test-delivery-agent",
          "description": "A model-free call of the host's campaign_test_send_plan on the passthrough road. It sends nothing and changes no draft: it resolves, once, the recipient the person typed and the drafts they chose (a random pick is made here and pinned) and answers what the publish card of the send step shows (sender, recipient, drafts with subject and preview) and the pinned plan the send takes (planJson). A refusal (no valid recipient, no drafts, too many drafts, a plan too large to show, no campaign access) is recorded by the host in the run's test-send record, which advances the form's cycle, so this step makes no external write; it answers ok false with lastSendResult and gateCycle, and the run goes back to the form. A host without this tool refuses the call, the run fails at this step and nothing is sent."
        }
      },
      "inputs": [
        {
          "title": "cinatra_run_id",
          "type": "string",
          "default": ""
        },
        {
          "title": "envelopeJson",
          "type": "string",
          "default": ""
        }
      ],
      "outputs": [
        {
          "title": "ok",
          "type": "boolean",
          "description": "True when the host planned the test send; false for a recorded refusal."
        },
        {
          "title": "sender",
          "type": "string",
          "description": "The From of the test messages as a person reads it; the card's From row."
        },
        {
          "title": "recipient",
          "type": "string",
          "description": "The recipient as typed and validated; the card's To row."
        },
        {
          "title": "drafts",
          "type": "array",
          "description": "One record per draft the send mails, with subject, preview, draftId and revision (at most 50); the card's Drafts row shows subject and preview."
        },
        {
          "title": "draftCount",
          "type": "integer",
          "description": "The number of drafts in the plan."
        },
        {
          "title": "planJson",
          "type": "string",
          "description": "The pinned plan the send step sends, as the host answered it."
        },
        {
          "title": "lastSendResult",
          "type": "object",
          "description": "The refusal the form shows on a refused plan; null on a planned one."
        },
        {
          "title": "gateCycle",
          "type": "integer",
          "description": "The form's cycle after a recorded refusal; 0 on a planned one."
        }
      ]
    },
    "branch_on_plan": {
      "component_type": "BranchingNode",
      "id": "branch_on_plan",
      "name": "Branch on the plan",
      "metadata": {
        "cinatra": {
          "purpose": "route-a-planned-test-send-to-the-publish-card-and-a-refusal-back-to-the-form"
        }
      },
      "inputs": [
        {
          "title": "ok",
          "type": "string"
        }
      ],
      "outputs": [],
      "branches": [
        "default",
        "refused",
        "send"
      ],
      "mapping": {
        "true": "send",
        "false": "refused"
      }
    },
    "perform_test_send": {
      "component_type": "ApiNode",
      "id": "perform_test_send",
      "name": "Perform the test send",
      "url": "{{CINATRA_BASE_URL}}/api/agents/passthrough",
      "http_method": "POST",
      "data": {
        "tool": "email_test_delivery_run_send",
        "input": {
          "planJson": "{# pyagentspec-input-hint (do not remove): {{ sender }} {{ recipient }} {{ drafts }} #}{{ planJson }}"
        },
        "agent_run_id": "{{ cinatra_run_id }}",
        "result_shape": "test_delivery_send"
      },
      "metadata": {
        "cinatra": {
          "riskClass": "test_send",
          "requiresApproval": false,
          "publishes": true,
          "publishRows": [
            {
              "label": "From",
              "input": "sender"
            },
            {
              "label": "To",
              "input": "recipient"
            },
            {
              "kind": "list",
              "label": "Drafts",
              "input": "drafts",
              "columns": [
                {
                  "label": "Subject",
                  "field": "subject"
                },
                {
                  "label": "Preview",
                  "field": "preview"
                }
              ]
            }
          ],
          "packageName": "@cinatra-ai/email-test-delivery-agent",
          "description": "The flow's one publishing step: a model-free call of the host's email_test_delivery_run_send on the passthrough road that sends exactly the plan the plan step answered (planJson) and nothing else. Sending a test email is an external write, so the host stops the run in front of this step and shows its publish card with the three rows declared here (From, To, Drafts with Subject and Preview); the run reaches the step only after a person chose to send there. The step's inputs come by data edges straight from the plan step, unchanged, so the card shows what the plan answered and the host checks the released decision against the plan before it mails. When the person declines the card, or it expires, the host stops the run and nothing is sent. The step returns the send's result to the form (lastSendResult, gateCycle and the form's defaults), so the person can plan another test send. requiresApproval is false because the publish card is the one approval in front of the send."
        }
      },
      "inputs": [
        {
          "title": "cinatra_run_id",
          "type": "string",
          "default": ""
        },
        {
          "title": "sender",
          "type": "string",
          "description": "The From of the test messages, as the plan step answered it; the card's From row."
        },
        {
          "title": "recipient",
          "type": "string",
          "description": "The recipient, as the plan step answered it; the card's To row."
        },
        {
          "title": "drafts",
          "type": "array",
          "description": "The drafts the send mails, as the plan step answered them; the card's Drafts row shows each subject and preview."
        },
        {
          "title": "planJson",
          "type": "string",
          "description": "The pinned plan, as the plan step answered it; the only argument of the send."
        }
      ],
      "outputs": [
        {
          "title": "lastSendResult",
          "type": "object"
        },
        {
          "title": "gateCycle",
          "type": "integer"
        },
        {
          "title": "recipientEmail",
          "type": "string"
        },
        {
          "title": "selectionMode",
          "type": "string"
